# Polymarket Bot Configuration

# MetaMask Wallet Configuration
# Private key for Polygon (plain hex 62-64 chars, or 0x prefixed 66 chars)
# Export from MetaMask: Settings > Security > Show Private Key
# Polygon keys typically come as plain hex without 0x prefix
POLY_PRIVATE_KEY=

# Wallet type: "EOA" (MetaMask), "SAFE" (Gnosis Safe), "PROXY" (Magic Link)
WALLET_TYPE=EOA

# Polymarket endpoints
POLY_CLOB_URL=https://clob.polymarket.com
POLY_GAMMA_URL=https://gamma-api.polymarket.com
POLY_DATA_URL=https://data-api.polymarket.com

# WebSocket endpoint
POLY_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

# Chain configuration
POLY_CHAIN_ID=137
POLY_RPC_URL=https://polygon-rpc.com

# Paper trading (true = simulated, false = live with real orders)
PAPER_TRADING=true

# Database configuration
DATABASE_URL=postgresql://polymarket_user:polymarket_pass@localhost:5434/polymarket_bot
DATABASE_POOL_SIZE=10

# Logging
RUST_LOG=info,polymarket_bot=debug
LOG_FILE=./logs/bot.log

# Risk management
MAX_POSITION_SIZE_USD=1000
MAX_DAILY_EXPOSURE_USD=20000
MAX_SLIPPAGE_TOLERANCE=0.02
STOP_LOSS_THRESHOLD=-100

# Strategy parameters
MIN_COMBINED_PRICE=0.98
ARBITRAGE_BUFFER=0.02
DEDUP_WINDOW_SECS=5

# Execution parameters
ORDER_TIMEOUT_SECS=5
HEARTBEAT_INTERVAL_SECS=10
WEBSOCKET_RECONNECT_MAX_SECS=30

# Market scanning
MARKET_LIMIT=100
SCAN_INTERVAL_MS=500
# Category filter: "sports" (default), "crypto", "political", "realworld", "all"
MARKET_CATEGORY=sports

# API rate limiting
GAMMA_API_RPS=2
CLOB_API_RPS=10
